import { Button, ComboBox, Palette, ScrollView, TextEdit } from "std-widgets.slint";
import { CameraInspector, FeatureRow } from "inspector.slint";
import { QuickSettings, QuickFeatureRow } from "quick_settings.slint";
import { ImageOrientation } from "image_orientation.slint";
import { QuickEditor } from "quick_editor.slint";
import { ActionButton } from "action_button.slint";
import { IpSettingsDialog } from "ip_settings.slint";
import { ModelPanel } from "model_panel.slint";

export component AppWindow inherits Window {
    title: "Basler Camera Test";
    preferred-width: 1120px;
    preferred-height: 760px;
    min-width: 800px;
    min-height: 600px;
    background: #f1f3f6;

    // This screen uses light surfaces, so native widgets need the same scheme
    // even when Windows is configured for dark mode.
    init => { Palette.color-scheme = ColorScheme.light; }

    in-out property <[string]> cameras: [];
    in-out property <int> selected-index: -1;
    in-out property <bool> selected-camera-gige: false;
    in-out property <bool> selected-camera-reachable: false;
    in-out property <string> selected-camera-mac: "";
    in-out property <string> selected-camera-ip: "";
    in-out property <string> selected-camera-mask: "";
    in-out property <string> selected-camera-gateway: "";
    in-out property <string> selected-camera-interface: "";
    in-out property <bool> ip-editor-open: false;
    in-out property <string> ip-editor-address: "";
    in-out property <string> ip-editor-mask: "";
    in-out property <string> ip-editor-gateway: "";
    in-out property <string> ip-error: "";
    in-out property <bool> ip-editor-dirty: root.ip-editor-open &&
        (root.ip-editor-address != root.selected-camera-ip || root.ip-editor-mask != root.selected-camera-mask ||
         root.ip-editor-gateway != (root.selected-camera-gateway == "" ? "0.0.0.0" : root.selected-camera-gateway));
    in-out property <int> language-index: 0;
    in-out property <bool> connected: false;
    in-out property <bool> live: false;
    in-out property <bool> busy: false;
    in-out property <bool> has-preview: false;
    in-out property <bool> has-snapshot: false;
    in-out property <image> preview;
    in-out property <int> preview-width: 4;
    in-out property <int> preview-height: 3;
    private property <float> preview-aspect: root.preview-height * 1.0 / root.preview-width;
    private property <length> live-panel-height: Math.max(310px, Math.min(root.height * 0.76, (root.width - 28px) * root.preview-aspect + 58px));
    in-out property <bool> live-detail-open: false;
    private property <int> live-detail-zoom-index: 0;
    private property <float> live-detail-fit-scale: Math.min((root.width - 64px) / (root.preview-width * 1px), (root.height - 126px) / (root.preview-height * 1px));
    private property <float> live-detail-scale: root.live-detail-zoom-index == 0 ? root.live-detail-fit-scale : root.live-detail-zoom-index == 1 ? 1 : 2;
    in-out property <image> snapshot;
    in-out property <string> status-text: "Ready";
    in-out property <string> saved-path: "";
    in-out property <string> log-text: "";
    in-out property <int> page-index: 0;
    in-out property <string> device-info: "";
    in-out property <string> actual-fps: "—";
    in-out property <string> configured-fps: "—";
    in-out property <string> model-pt-path: "";
    in-out property <string> model-path: "";
    in-out property <string> model-image-path: "";
    in-out property <int> model-source-index: 0;
    in-out property <string> model-status: "";
    in-out property <bool> model-ready: false;
    in-out property <bool> model-busy: false;
    in-out property <bool> model-error: false;
    in-out property <bool> model-has-result: false;
    in-out property <int> model-count: 0;
    in-out property <string> model-run-ms: "—";
    in-out property <string> model-processing-ms: "—";
    in-out property <string> model-processed-fps: "—";
    in-out property <string> model-age-ms: "—";
    in-out property <bool> model-looping: false;
    in-out property <int> model-processed-images: 0;
    in-out property <image> model-preview;
    in-out property <string> model-input-size: "";
    in-out property <string> model-default-size: "";
    in-out property <string> model-size-draft: "";
    in-out property <int> model-size-source: 0;
    in-out property <string> model-size-error: "";
    in-out property <int> model-annotation-mode: 1;
    in-out property <float> model-result-aspect: 0.32;
    private property <length> model-panel-height: 299px + Math.max(170px, Math.min(520px, (root.width - 40px) * root.model-result-aspect));
    in-out property <bool> model-detail-open: false;
    in-out property <image> model-detail-image;
    in-out property <int> model-detail-width: 1;
    in-out property <int> model-detail-height: 1;
    private property <int> model-detail-zoom-index: 0;
    private property <float> model-detail-fit-scale: Math.min((root.width - 64px) / (root.model-detail-width * 1px), (root.height - 126px) / (root.model-detail-height * 1px));
    private property <float> model-detail-scale: root.model-detail-zoom-index == 0 ? root.model-detail-fit-scale : root.model-detail-zoom-index == 1 ? 1 : root.model-detail-zoom-index == 2 ? 2 : 4;
    private property <bool> confirm-model-export: false;
    in-out property <[FeatureRow]> feature-rows: [];
    in-out property <[QuickFeatureRow]> quick-features: [];
    in-out property <bool> rotate-available: false;
    in-out property <bool> rotated-180: false;
    in-out property <int> roi-ratio-index: 0;
    in-out property <bool> roi-available: false;
    in-out property <string> roi-max-text: "";
    in-out property <bool> roi-input-valid: true;
    in-out property <string> roi-paired-preview: "";
    in-out property <int> image-rotation-index: 0;
    in-out property <bool> transform-flip-horizontal: false;
    in-out property <bool> transform-flip-vertical: false;
    in-out property <bool> quick-editor-open: false;
    private property <string> quick-editor-id: "";
    private property <bool> confirm-rotate: false;
    private property <bool> confirm-roi: false;
    private property <bool> rotate-target: false;
    in-out property <string> selected-feature-key: "";
    in-out property <string> feature-name: "";
    in-out property <string> feature-meta: "";
    in-out property <string> feature-value: "";
    in-out property <string> feature-description: "";
    in-out property <string> feature-limits: "";
    in-out property <[string]> feature-options: [];
    in-out property <bool> feature-editable: false;
    in-out property <string> feature-error: "";
    in-out property <string> editor-value: "";
    in-out property <string> feature-search: "";
    private property <bool> editor-dirty: root.feature-editable && root.editor-value != root.feature-value;
    private property <bool> confirm-disconnect: false;
    in-out property <bool> confirm-exit: false;

    callback refresh();
    callback select-camera(int);
    callback configure-ip(int, string, string, string, bool);
    callback connect(int);
    callback disconnect();
    callback start-live();
    callback stop-live();
    callback capture();
    callback change-language(int);
    callback refresh-features();
    callback search-features(string);
    callback select-feature(string);
    callback toggle-category(string);
    callback apply-feature(string);
    callback rotate-180(bool);
    callback set-roi-ratio(int);
    callback apply-max-roi();
    callback preview-roi-value(string);
    callback rotate-image-90();
    callback toggle-image-horizontal();
    callback toggle-image-vertical();
    callback reset-image-transform();
    callback pick-pt-model();
    callback export-model(string);
    callback pick-onnx-model();
    callback unload-model();
    callback select-model-source(int);
    callback pick-model-image();
    callback pick-model-folder();
    callback start-model-loop();
    callback stop-model-loop();
    callback open-model-detail();
    callback close-model-detail();
    callback apply-model-input-size(string);
    callback reset-model-input-size();
    callback set-model-annotation-mode(int);

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        HorizontalLayout {
            height: 38px;
            spacing: 12px;
            Text {
                text: "BASLER / CAMERA TEST";
                color: #172334;
                font-size: 24px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            ComboBox {
                width: 132px;
                model: ["English", "Tiếng Việt"];
                current-index <=> root.language-index;
                selected(_) => { root.change-language(root.language-index); }
            }
        }

        Rectangle {
            height: 124px;
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #dce2e9;
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 8px;
                spacing: 8px;
                HorizontalLayout {
                    height: 32px;
                    spacing: 9px;
                    Text {
                        text: root.language-index == 1 ? "Camera" : "Camera";
                        width: 67px;
                        color: #46566b;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        model: root.cameras;
                        current-index <=> root.selected-index;
                        enabled: !root.connected && !root.busy;
                        horizontal-stretch: 1;
                        selected(_) => { root.select-camera(root.selected-index); }
                    }
                    ActionButton {
                        text: root.language-index == 1 ? "Thiết lập IP" : "Configure IP";
                        tone: 4;
                        enabled: !root.connected && !root.busy && root.selected-camera-gige;
                        clicked => { root.ip-error = ""; root.ip-editor-open = true; }
                    }
                    ActionButton {
                        text: root.language-index == 1 ? "Làm mới" : "Refresh";
                        tone: 6;
                        enabled: !root.connected && !root.busy;
                        clicked => { root.busy = true; root.refresh(); }
                    }
                    ActionButton {
                        text: root.connected
                            ? (root.language-index == 1 ? "Ngắt kết nối" : "Disconnect")
                            : (root.language-index == 1 ? "Kết nối" : "Connect");
                        tone: root.connected ? 5 : 2;
                        enabled: !root.busy && (root.connected || (root.selected-index >= 0 && root.selected-camera-reachable));
                        clicked => {
                            if (root.connected && root.editor-dirty) {
                                root.confirm-disconnect = true;
                            } else {
                                root.busy = true;
                                if (root.connected) { root.disconnect(); }
                                else { root.connect(root.selected-index); }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: 32px;
                    spacing: 9px;
                    ActionButton {
                        text: root.live
                            ? (root.language-index == 1 ? "Dừng live" : "Stop live")
                            : (root.language-index == 1 ? "Bắt đầu live" : "Start live");
                        tone: root.live ? 4 : 2;
                        enabled: root.connected && !root.busy && !root.editor-dirty;
                        clicked => {
                            root.busy = true;
                            if (root.live) { root.stop-live(); }
                            else { root.start-live(); }
                        }
                    }
                    ActionButton {
                        text: root.language-index == 1 ? "Chụp và lưu PNG" : "Capture PNG";
                        tone: 3;
                        enabled: root.connected && !root.busy;
                        clicked => { root.busy = true; root.capture(); }
                    }
                    Text {
                        text: root.connected
                            ? (root.live ? "● LIVE" : (root.language-index == 1 ? "● ĐÃ KẾT NỐI" : "● CONNECTED"))
                            : (root.language-index == 1 ? "○ CHƯA KẾT NỐI" : "○ DISCONNECTED");
                        color: root.live ? #087c56 : #68788c;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                    }
                }
                Text {
                    height: 19px;
                    text: root.selected-camera-gige
                        ? (root.selected-camera-reachable
                            ? "GigE  ·  IP " + root.selected-camera-ip + "  ·  MAC " + root.selected-camera-mac + "  ·  NIC " + root.selected-camera-interface
                            : (root.language-index == 1 ? "SAI DẢI IP  ·  " : "WRONG SUBNET  ·  ") + root.selected-camera-ip + "  ·  MAC " + root.selected-camera-mac + "  ·  NIC " + root.selected-camera-interface)
                        : "";
                    color: root.selected-camera-reachable ? #53677f : #b42332;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }

        HorizontalLayout {
            height: 32px;
            spacing: 7px;
            Button {
                text: root.language-index == 1 ? "Xem ảnh" : "Monitor";
                primary: root.page-index == 0;
                clicked => { root.page-index = 0; }
            }
            Button {
                text: root.language-index == 1 ? "Thông tin & thông số" : "Info & features";
                primary: root.page-index == 1;
                clicked => { root.page-index = 1; }
            }
            Button {
                text: root.language-index == 1 ? "Ảnh chụp & log" : "Capture & log";
                primary: root.page-index == 2;
                clicked => { root.page-index = 2; }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        if root.page-index == 0 : Rectangle {
            vertical-stretch: 1;
            min-width: 0px;
            min-height: 0px;
            preferred-width: 0px;
            preferred-height: 0px;

            monitor-scroll := ScrollView {
                width: parent.width;
                height: parent.height;
                horizontal-scrollbar-policy: always-off;
                content-height: Math.max(self.visible-height, (root.width < 920px ? 425px : 255px) + root.live-panel-height + root.model-panel-height + 20px);

            VerticalLayout {
                width: monitor-scroll.visible-width;
                height: monitor-scroll.content-height;
                spacing: 10px;

            Rectangle {
                height: root.live-panel-height;
                background: #ffffff;
                border-radius: 8px;
                border-width: 1px;
                border-color: #dce2e9;
                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding: 10px;
                    spacing: 6px;
                    HorizontalLayout {
                        height: 31px;
                        Text {
                            text: root.language-index == 1 ? "XEM TRỰC TIẾP" : "LIVE VIEW";
                            color: #46566b;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        ActionButton {
                            text: root.language-index == 1 ? "Xem lớn" : "Expand";
                            tone: 1;
                            enabled: root.has-preview;
                            clicked => { root.live-detail-zoom-index = 0; root.live-detail-open = true; }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: #111a27;
                        Image {
                            source: root.preview;
                            width: parent.width;
                            height: parent.height;
                            image-fit: contain;
                            accessible-label: "Live camera image";
                        }
                        Text {
                            visible: !root.has-preview;
                            width: parent.width;
                            height: parent.height;
                            text: root.language-index == 1 ? "Kết nối camera để xem ảnh" : "Connect a camera to view frames";
                            color: #a8b5c5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        if root.live : Rectangle {
                            x: 12px;
                            y: 12px;
                            width: 132px;
                            height: 30px;
                            background: #111a27db;
                            border-radius: 4px;
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: "● LIVE  " + root.actual-fps + " FPS";
                                color: #ffffff;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        if root.model-has-result && root.model-source-index == 0 : Rectangle {
                            x: parent.width - 154px;
                            y: 12px;
                            width: 142px;
                            height: 30px;
                            background: #087e8b;
                            border-radius: 4px;
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: "AI  " + root.model-count + "  ·  " + root.model-processed-fps + " FPS";
                                color: #ffffff;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            FlexboxLayout {
                height: root.width < 920px ? 425px : 255px;
                spacing: 10px;
                flex-direction: root.width < 920px ? column : row;
                flex-wrap: no-wrap;
                alignment: stretch;
                QuickSettings {
                    horizontal-stretch: 3;
                    min-width: 500px;
                    height: 255px;
                    connected: root.connected;
                    busy: root.busy;
                    dirty: root.editor-dirty;
                    language-index: root.language-index;
                    rows: root.quick-features;
                    rotate-available: root.rotate-available;
                    rotated-180: root.rotated-180;
                    roi-ratio-index <=> root.roi-ratio-index;
                    roi-available: root.roi-available;
                    roi-max-text: root.roi-max-text;
                    select-roi-ratio(index) => { root.set-roi-ratio(index); }
                    apply-max-roi => { root.confirm-roi = true; }
                    edit-feature(id) => {
                        root.quick-editor-id = id;
                        root.quick-editor-open = true;
                        root.select-feature(id);
                    }
                    rotate-180(enabled) => {
                        root.rotate-target = enabled;
                        root.confirm-rotate = true;
                    }
                }
                ImageOrientation {
                    horizontal-stretch: 2;
                    min-width: 350px;
                    height: root.width < 920px ? 160px : 255px;
                    connected: root.connected;
                    busy: root.busy;
                    language-index: root.language-index;
                    image-rotation-index: root.image-rotation-index;
                    flip-horizontal: root.transform-flip-horizontal;
                    flip-vertical: root.transform-flip-vertical;
                    rotate-clockwise => { root.rotate-image-90(); }
                    toggle-horizontal => { root.toggle-image-horizontal(); }
                    toggle-vertical => { root.toggle-image-vertical(); }
                    reset-image => { root.reset-image-transform(); }
                }
            }
            ModelPanel {
                height: root.model-panel-height;
                language-index: root.language-index;
                pt-path: root.model-pt-path;
                onnx-path: root.model-path;
                image-path: root.model-image-path;
                source-index: root.model-source-index;
                status: root.model-status;
                ready: root.model-ready;
                busy: root.model-busy;
                error: root.model-error;
                has-result: root.model-has-result;
                count: root.model-count;
                model-ms: root.model-run-ms;
                processing-ms: root.model-processing-ms;
                processed-fps: root.model-processed-fps;
                age-ms: root.model-age-ms;
                looping: root.model-looping;
                processed-images: root.model-processed-images;
                result-image: root.model-preview;
                current-size: root.model-input-size;
                default-size: root.model-default-size;
                size-draft <=> root.model-size-draft;
                size-source: root.model-size-source;
                annotation-mode: root.model-annotation-mode;
                size-error: root.model-size-error;
                apply-size(value) => { root.model-busy = true; root.apply-model-input-size(value); }
                reset-size => { root.model-busy = true; root.reset-model-input-size(); }
                set-annotation-mode(index) => { root.model-busy = true; root.set-model-annotation-mode(index); }
                pick-pt => { root.pick-pt-model(); }
                export-model(path) => { root.confirm-model-export = true; }
                pick-onnx => { root.pick-onnx-model(); }
                unload-model => { root.unload-model(); }
                select-source(index) => { root.select-model-source(index); }
                pick-image => { root.pick-model-image(); }
                pick-folder => { root.pick-model-folder(); }
                start-loop => { root.start-model-loop(); }
                stop-loop => { root.stop-model-loop(); }
                open-detail => { root.model-detail-zoom-index = 0; root.open-model-detail(); }
            }
            }
            }
        }

        if root.page-index == 1 : CameraInspector {
            vertical-stretch: 1;
            connected: root.connected;
            busy: root.busy;
            language-index: root.language-index;
            device-info: root.device-info;
            actual-fps: root.actual-fps;
            configured-fps: root.configured-fps;
            feature-rows: root.feature-rows;
            selected-key: root.selected-feature-key;
            feature-name: root.feature-name;
            feature-meta: root.feature-meta;
            feature-value: root.feature-value;
            feature-description: root.feature-description;
            feature-limits: root.feature-limits;
            feature-options: root.feature-options;
            feature-editable: root.feature-editable;
            feature-error: root.feature-error;
            roi-input-valid: root.roi-input-valid;
            roi-paired-preview: root.roi-paired-preview;
            editor-value <=> root.editor-value;
            search-value <=> root.feature-search;
            refresh-features => { root.refresh-features(); }
            search-features(value) => { root.search-features(value); }
            select-feature(id) => { root.select-feature(id); }
            toggle-category(id) => { root.toggle-category(id); }
            apply-feature(value) => { root.busy = true; root.apply-feature(value); }
            preview-roi-value(value) => { root.preview-roi-value(value); }
        }

        if root.page-index == 2 : HorizontalLayout {
            vertical-stretch: 1;
            spacing: 10px;
            Rectangle {
                horizontal-stretch: 3;
                background: #ffffff;
                border-radius: 8px;
                border-width: 1px;
                border-color: #dce2e9;
                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding: 10px;
                    spacing: 6px;
                    Text {
                        height: 21px;
                        text: root.language-index == 1 ? "LOG CAMERA" : "CAMERA LOG";
                        color: #46566b;
                        font-size: 13px;
                        font-weight: 700;
                    }
                    TextEdit {
                        text: root.log-text;
                        read-only: true;
                        font-family: "Consolas";
                        font-size: 12px;
                        vertical-stretch: 1;
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 2;
                min-width: 310px;
                background: #ffffff;
                border-radius: 8px;
                border-width: 1px;
                border-color: #dce2e9;
                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding: 8px;
                    spacing: 5px;
                    Text {
                        height: 20px;
                        text: root.language-index == 1 ? "ẢNH ĐÃ CHỤP" : "LAST CAPTURE";
                        color: #46566b;
                        font-size: 12px;
                        font-weight: 700;
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: #111a27;
                        Image {
                            source: root.snapshot;
                            width: parent.width;
                            height: parent.height;
                            image-fit: contain;
                            accessible-label: "Last captured image";
                        }
                        Text {
                            visible: !root.has-snapshot;
                            width: parent.width;
                            height: parent.height;
                            text: root.language-index == 1 ? "Chưa có ảnh chụp" : "No capture yet";
                            color: #a8b5c5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        height: 24px;
                        text: root.saved-path;
                        color: #53677f;
                        font-size: 10px;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                }
            }
        }

        Text {
            height: 20px;
            text: root.editor-dirty
                ? (root.language-index == 1 ? "Thông số chưa lưu: Lưu hoặc Bỏ thay đổi trước khi chuyển live view." : "Unsaved setting: Save or Discard before changing live view.")
                : root.status-text;
            color: #53677f;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if root.ip-editor-open : IpSettingsDialog {
        width: parent.width;
        height: parent.height;
        language-index: root.language-index;
        busy: root.busy;
        mac: root.selected-camera-mac;
        old-ip: root.selected-camera-ip;
        old-mask: root.selected-camera-mask;
        old-gateway: root.selected-camera-gateway == "" ? "0.0.0.0" : root.selected-camera-gateway;
        interface-ip: root.selected-camera-interface;
        error-text: root.ip-error;
        ip <=> root.ip-editor-address;
        mask <=> root.ip-editor-mask;
        gateway <=> root.ip-editor-gateway;
        apply(ip, mask, gateway, persistent) => {
            root.busy = true;
            root.configure-ip(root.selected-index, ip, mask, gateway, persistent);
        }
        close => { root.ip-editor-open = false; }
    }

    if root.quick-editor-open : QuickEditor {
        width: parent.width;
        height: parent.height;
        busy: root.busy;
        language-index: root.language-index;
        request-id: root.quick-editor-id;
        selected-key: root.selected-feature-key;
        feature-name: root.feature-name;
        feature-value: root.feature-value;
        feature-limits: root.feature-limits;
        feature-description: root.feature-description;
        feature-error: root.feature-error;
        roi-input-valid: root.roi-input-valid;
        roi-paired-preview: root.roi-paired-preview;
        feature-options: root.feature-options;
        feature-editable: root.feature-editable;
        editor-value <=> root.editor-value;
        apply-feature(value) => { root.busy = true; root.apply-feature(value); }
        preview-roi-value(value) => { root.preview-roi-value(value); }
        close-editor => { root.quick-editor-open = false; }
    }

    if root.confirm-model-export : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #111a2799;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            width: Math.min(430px, parent.width - 36px);
            height: 155px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #ffffff;
            border-radius: 8px;
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 18px;
                spacing: 12px;
                Text {
                    text: root.language-index == 1 ? "Xuất model sang ONNX?" : "Export model to ONNX?";
                    color: #172334;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: root.model-pt-path;
                    color: #53677f;
                    font-size: 11px;
                    overflow: elide;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: root.language-index == 1 ? "Hủy" : "Cancel";
                        clicked => { root.confirm-model-export = false; }
                    }
                    ActionButton {
                        text: root.language-index == 1 ? "Xuất ONNX" : "Export ONNX";
                        tone: 3;
                        clicked => {
                            root.confirm-model-export = false;
                            root.export-model(root.model-pt-path);
                        }
                    }
                }
            }
        }
    }

    if root.confirm-roi : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #111a2799;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            width: Math.min(410px, parent.width - 36px);
            height: 160px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #ffffff;
            border-radius: 8px;
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 18px;
                spacing: 12px;
                Text {
                    text: root.language-index == 1 ? "Xác nhận lưu vùng ảnh camera?" : "Save the camera image ROI?";
                    color: #172334;
                    font-weight: 700;
                    font-size: 16px;
                }
                Text {
                    text: (root.language-index == 1 ? "Kích thước tối đa, căn giữa: " : "Largest centered size: ") + root.roi-max-text;
                    color: #53677f;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: root.language-index == 1 ? "Hủy" : "Cancel";
                        clicked => { root.confirm-roi = false; }
                    }
                    ActionButton {
                        text: root.language-index == 1 ? "Xác nhận" : "Confirm";
                        tone: 2;
                        clicked => {
                            root.confirm-roi = false;
                            root.busy = true;
                            root.apply-max-roi();
                        }
                    }
                }
            }
        }
    }

    if root.confirm-rotate : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #111a2799;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            width: Math.min(390px, parent.width - 36px);
            height: 165px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #ffffff;
            border-radius: 8px;
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 18px;
                spacing: 12px;
                Text {
                    text: root.rotate-target
                        ? (root.language-index == 1 ? "Xoay ảnh trên camera 180°?" : "Rotate the camera image 180°?")
                        : (root.language-index == 1 ? "Tắt cả ReverseX và ReverseY?" : "Clear both ReverseX and ReverseY?");
                    color: #172334;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: root.language-index == 1
                        ? "Ứng dụng sẽ chỉnh ReverseX và ReverseY trong phiên kết nối này."
                        : "This changes ReverseX and ReverseY for this connection session.";
                    color: #53677f;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: root.language-index == 1 ? "Hủy" : "Cancel";
                        clicked => { root.confirm-rotate = false; }
                    }
                    ActionButton {
                        text: root.language-index == 1 ? "Xác nhận" : "Confirm";
                        tone: 6;
                        clicked => {
                            root.confirm-rotate = false;
                            root.busy = true;
                            root.rotate-180(root.rotate-target);
                        }
                    }
                }
            }
        }
    }

    if root.confirm-disconnect : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #111a2799;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            width: 370px;
            height: 145px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #ffffff;
            border-radius: 8px;
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 18px;
                spacing: 10px;
                Text {
                    text: root.language-index == 1 ? "Bỏ thay đổi chưa lưu và ngắt kết nối?" : "Discard unsaved change and disconnect?";
                    color: #172334;
                    wrap: word-wrap;
                    font-weight: 700;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: root.language-index == 1 ? "Hủy" : "Cancel";
                        clicked => { root.confirm-disconnect = false; }
                    }
                    ActionButton {
                        text: root.language-index == 1 ? "Ngắt kết nối" : "Disconnect";
                        tone: 5;
                        clicked => {
                            root.confirm-disconnect = false;
                            root.editor-value = root.feature-value;
                            root.ip-editor-open = false;
                            root.busy = true;
                            root.disconnect();
                        }
                    }
                }
            }
        }
    }

    if root.confirm-exit : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #111a2799;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            width: 370px;
            height: 145px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #ffffff;
            border-radius: 8px;
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 18px;
                spacing: 10px;
                Text {
                    text: root.language-index == 1 ? "Bỏ thay đổi chưa lưu và thoát?" : "Discard unsaved change and exit?";
                    color: #172334;
                    wrap: word-wrap;
                    font-weight: 700;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: root.language-index == 1 ? "Hủy" : "Cancel";
                        clicked => { root.confirm-exit = false; }
                    }
                    ActionButton {
                        text: root.language-index == 1 ? "Thoát" : "Exit";
                        tone: 5;
                        clicked => {
                            root.editor-value = root.feature-value;
                            root.confirm-exit = false;
                            root.close();
                        }
                    }
                }
            }
        }
    }

    if root.live-detail-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #111a27d9;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            x: 18px;
            y: 18px;
            width: parent.width - 36px;
            height: parent.height - 36px;
            background: #ffffff;
            border-radius: 8px;
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 10px;
                spacing: 8px;
                HorizontalLayout {
                    height: 34px;
                    spacing: 6px;
                    Text {
                        text: (root.language-index == 1 ? "ẢNH XEM TRƯỚC  ·  " : "LIVE PREVIEW  ·  ") + root.preview-width + " × " + root.preview-height;
                        color: #172334;
                        font-size: 14px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    ActionButton {
                        text: root.language-index == 1 ? "Vừa khung" : "Fit";
                        tone: root.live-detail-zoom-index == 0 ? 1 : 0;
                        clicked => { root.live-detail-zoom-index = 0; }
                    }
                    ActionButton {
                        text: "100%";
                        tone: root.live-detail-zoom-index == 1 ? 1 : 0;
                        clicked => { root.live-detail-zoom-index = 1; }
                    }
                    ActionButton {
                        text: "200%";
                        tone: root.live-detail-zoom-index == 2 ? 1 : 0;
                        clicked => { root.live-detail-zoom-index = 2; }
                    }
                    ActionButton {
                        text: root.language-index == 1 ? "Đóng" : "Close";
                        tone: 5;
                        clicked => { root.live-detail-open = false; }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: #111a27;
                    live-detail-scroll := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        horizontal-scrollbar-policy: as-needed;
                        vertical-scrollbar-policy: as-needed;
                        mouse-drag-pan-enabled: true;
                        content-width: Math.max(self.visible-width, root.preview-width * 1px * root.live-detail-scale);
                        content-height: Math.max(self.visible-height, root.preview-height * 1px * root.live-detail-scale);
                        Rectangle {
                            width: live-detail-scroll.content-width;
                            height: live-detail-scroll.content-height;
                            background: #111a27;
                            Image {
                                source: root.preview;
                                width: root.preview-width * 1px * root.live-detail-scale;
                                height: root.preview-height * 1px * root.live-detail-scale;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                image-fit: fill;
                                accessible-label: "Live camera image enlarged";
                            }
                        }
                    }
                    if root.live : Rectangle {
                        x: 12px;
                        y: 12px;
                        width: 132px;
                        height: 30px;
                        background: #111a27db;
                        border-radius: 4px;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "● LIVE  " + root.actual-fps + " FPS";
                            color: #ffffff;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    height: 16px;
                    text: root.language-index == 1 ? "Kéo ảnh để di chuyển khi phóng to" : "Drag to pan when zoomed";
                    color: #61748c;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.model-detail-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #111a27d9;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            x: 18px;
            y: 18px;
            width: parent.width - 36px;
            height: parent.height - 36px;
            background: #ffffff;
            border-radius: 8px;
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 10px;
                spacing: 8px;
                HorizontalLayout {
                    height: 34px;
                    spacing: 6px;
                    Text {
                        text: (root.language-index == 1 ? "ẢNH DETECT  ·  " : "DETECTION IMAGE  ·  ") + root.model-detail-width + " × " + root.model-detail-height;
                        color: #172334;
                        font-size: 14px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    ActionButton {
                        text: root.language-index == 1 ? "Vừa khung" : "Fit";
                        tone: root.model-detail-zoom-index == 0 ? 1 : 0;
                        clicked => { root.model-detail-zoom-index = 0; }
                    }
                    ActionButton {
                        text: "100%";
                        tone: root.model-detail-zoom-index == 1 ? 1 : 0;
                        clicked => { root.model-detail-zoom-index = 1; }
                    }
                    ActionButton {
                        text: "200%";
                        tone: root.model-detail-zoom-index == 2 ? 1 : 0;
                        clicked => { root.model-detail-zoom-index = 2; }
                    }
                    ActionButton {
                        text: "400%";
                        tone: root.model-detail-zoom-index == 3 ? 1 : 0;
                        clicked => { root.model-detail-zoom-index = 3; }
                    }
                    ActionButton {
                        text: root.language-index == 1 ? "Đóng" : "Close";
                        tone: 5;
                        clicked => { root.model-detail-open = false; root.close-model-detail(); }
                    }
                }
                detail-scroll := ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: as-needed;
                    vertical-scrollbar-policy: as-needed;
                    mouse-drag-pan-enabled: true;
                    content-width: Math.max(self.visible-width, root.model-detail-width * 1px * root.model-detail-scale);
                    content-height: Math.max(self.visible-height, root.model-detail-height * 1px * root.model-detail-scale);
                    Rectangle {
                        width: detail-scroll.content-width;
                        height: detail-scroll.content-height;
                        background: #111a27;
                        Image {
                            source: root.model-detail-image;
                            width: root.model-detail-width * 1px * root.model-detail-scale;
                            height: root.model-detail-height * 1px * root.model-detail-scale;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            image-fit: fill;
                            accessible-label: "Frozen detection result at full image resolution";
                        }
                    }
                }
                Text {
                    height: 16px;
                    text: root.language-index == 1 ? "Kéo ảnh để di chuyển khi đã phóng to · Ảnh này đứng yên, AI vẫn chạy" : "Drag to pan when zoomed · This image stays frozen while AI continues";
                    color: #61748c;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
